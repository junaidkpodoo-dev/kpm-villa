<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kpm_villa_enquiry_tree" model="ir.ui.view">
        <field name="name">kpm.villa.enquiry.tree</field>
        <field name="model">kpm.villa.enquiry</field>
        <field name="arch" type="xml">
            <list string="Enquiries">
                <field name="name"/>
                <field name="phone" widget="phone"/>
                <field name="location"/>
                <field name="description"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_kpm_villa_enquiry_form" model="ir.ui.view">
        <field name="name">kpm.villa.enquiry.form</field>
        <field name="model">kpm.villa.enquiry</field>
        <field name="arch" type="xml">
            <form string="Enquiry">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group>
                            <field name="location"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kpm_villa_enquiry" model="ir.actions.act_window">
        <field name="name">Enquiries</field>
        <field name="res_model">kpm.villa.enquiry</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
